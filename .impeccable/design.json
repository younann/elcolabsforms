  "narrative": {
    "northStar": "The Stock App",
    "overview": "ELCO looks like an app Apple could have shipped, at the craft of Apple's own apps, Wolt and Linear. Grouped inset lists on the iOS grouped palette, frosted bars, push transitions and sheets. Crimson is the tint; gold lives only in the shield mark. Built for inspectors in sun and dim rooms, one-handed, Hebrew RTL.",
    "keyCharacteristics": [
      "System font stack only.",
      "One rounded group per list section.",
      "Crimson tint; gold only in the mark.",
      "Frosted nav and tab bars, 0.5px separators.",
      "Row highlight on press in lists, 0.97 scale on standalone controls."
    ],
    "rules": [
      {
        "name": "The Accent vs Accent-Fill Rule",
        "body": "--accent is for text, icons and outlines and brightens in dark mode; --accent-fill is for any surface with a white label and stays #c8102e in dark mode.",
        "section": "colors"
      },
      {
        "name": "The Gold-Only-In-The-Mark Rule",
        "body": "--gold is for the shield wordmark and login only.",
        "section": "colors"
      },
      {
        "name": "The Meaning-Only Status Rule",
        "body": "Green, amber and blue appear only when they mean success, attention or info.",
        "section": "colors"
      },
      {
        "name": "The System Face Rule",
        "body": "The system stack is the brand; no web fonts.",
        "section": "typography"
      },
      {
        "name": "The Frosted-Bars Rule",
        "body": "Nav and tab bars always use .material, never an opaque flat fill.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do put list content in a .group-list with rows, not one bordered card per item.",
      "Do use --accent-fill for any filled surface with a white label and --accent for tinted text and icons.",
      "Do keep targets at 44px minimum and inputs at 16px minimum.",
      "Do use logical properties for RTL.",
      "Do use .material for bars, route-push for task pages and route-tab for tab pages.",
      "Do keep dark mode on true black with #1c1c1e groups."
    ],
    "donts": [
      "Don't reintroduce IBM Plex or any web font, signal-orange, or bordered stacked cards.",
      "Don't use --gold outside the shield wordmark and login.",
      "Don't scale whole rows or cards on press inside a group; highlight the row.",
      "Don't use status colours decoratively.",
      "Don't use an opaque flat header or tab bar."
    ]
  }
}