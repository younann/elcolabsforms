      "css": ".ds-seg{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;gap:4px;padding:4px;background:#e9e9ef;border-radius:12px;font:16px -apple-system,system-ui,sans-serif}.ds-seg button{min-height:44px;border:0;border-radius:7px;background:transparent;color:#0b0b0d;font:500 16px inherit;cursor:pointer;transition:transform 150ms cubic-bezier(.23,1,.32,1)}.ds-seg button:active{transform:scale(.97)}.ds-seg button[aria-checked=true]{background:#0b0b0d;color:#fff}.ds-seg button:focus-visible{outline:2px solid #c8102e;outline-offset:2px}"
