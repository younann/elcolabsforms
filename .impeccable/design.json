      "css": ".ds-group{list-style:none;margin:0;padding:0;background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 1px 2px hsl(240 10% 20%/.06),0 6px 20px -8px hsl(240 10% 20%/.14);font:17px -apple-system,system-ui,sans-serif}.ds-group li{position:relative}.ds-group li+li::before{content:'';position:absolute;inset-inline:16px 0;top:0;height:.5px;background:rgb(60 60 67/.2)}.ds-group a{display:flex;justify-content:space-between;padding:12px 16px;min-height:44px;box-sizing:border-box;align-items:center;color:#0b0b0d;text-decoration:none}.ds-group a:active{background:#e9e9ef}.ds-group a:focus-visible{outline:2px solid #c8102e;outline-offset:-2px}.ds-group span{color:#63636a;font-weight:600}"
